{
  "name": "@adxtya21/decisionkit",
  "version": "0.4.0",
  "description": "Fast, cheap, probability-scored decisions for coding agents, scripts and CI: a CLI and MCP server for the OpenAI Decisions API and Jev (TypeSafe AI)",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/server.mjs --legal-comments=none",
    "typecheck": "tsc",
    "test": "node --test \"test/*.test.ts\"",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run build && npm run check"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude-code",
    "claude-code-plugin",
    "codex",
    "cursor",
    "ai-agents",
    "llm",
    "decision-api",
    "classification",
    "openai",
    "jev",
    "typesafe",
    "openrouter",
    "cli",
    "ci",
    "developer-tools"
  ],
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "zod": "4.6.5"
  },
  "bin": {
    "decisionkit": "dist/server.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adityajha2005/decisionkit.git"
  },
  "homepage": "https://github.com/adityajha2005/decisionkit#readme",
  "publishConfig": {
    "access": "public"
  }
}
